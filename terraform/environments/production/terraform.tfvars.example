# Production Environment - Example Variables
# Copy this file to terraform.tfvars and fill in your values

# SSH Configuration
ssh_user     = "ubuntu"
ssh_key_path = "~/.ssh/id_rsa"

# K3s Configuration
k3s_version = "v1.28.4+k3s1"

# Component Versions
argocd_version           = "5.51.4"
external_secrets_version = "0.9.9"
prometheus_version       = "54.2.2"

# Monitoring
install_monitoring = false  # Set to true if not using separate monitoring server

# Grafana (if monitoring is enabled)
grafana_admin_password = "your-secure-password-here"
