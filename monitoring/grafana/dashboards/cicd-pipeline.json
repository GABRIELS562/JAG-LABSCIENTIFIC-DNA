            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 3 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "up{job=\"lims-production\"}",
          "legendFormat": "Production",
          "refId": "A"
        }
      ],
      "title": "Production Environment",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\"lims-.*\"}[5m])) by (environment)",
          "legendFormat": "{{ environment }}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Environment",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"lims-.*\"}[5m])) by (le, environment))",
          "legendFormat": "{{ environment }} p95",
          "refId": "A"
        }
      ],
      "title": "Response Time (p95) by Environment",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "targets": [
        {
          "expr": "100 - (sum(rate(http_requests_total{job=~\"lims-.*\", status=~\"5..\"}[5m])) by (environment) / sum(rate(http_requests_total{job=~\"lims-.*\"}[5m])) by (environment) * 100)",
          "legendFormat": "{{ environment }}",
          "refId": "A"
        }
      ],
      "title": "Success Rate by Environment",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{ server }}",
          "refId": "A"
        }
      ],
      "title": "Memory Usage by Server",
      "type": "gauge"
    }
  ],
