{
  "dashboard": {
    "id": null,
    "uid": "lims-application",
    "title": "LIMS Application Metrics",
    "tags": ["lims", "application", "dna-analysis"],
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "custom",
          "query": "production,develop,test",
          "current": {"text": "production", "value": "production"},
          "options": [
            {"text": "production", "value": "production"},
            {"text": "develop", "value": "develop"},
            {"text": "test", "value": "test"}
          ]
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Service Health",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Service Status",
        "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "up{job=\"lims-$environment\"}",
            "legendFormat": "Status",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": {"calcs": ["lastNotNull"]}
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Request Rate",
        "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(lims_http_request_duration_seconds_count{environment=\"$environment\"}[5m]))",
            "legendFormat": "req/s",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Avg Response Time",
        "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(lims_http_request_duration_seconds_bucket{environment=\"$environment\"}[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "red", "value": 2}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Error Rate",
        "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(lims_errors_total{environment=\"$environment\"}[5m])) or vector(0)",
            "legendFormat": "errors/s",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "DB Connections",
        "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "lims_database_connections{environment=\"$environment\"}",
            "legendFormat": "connections",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 15},
                {"color": "red", "value": 20}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "type": "gauge",
        "title": "Memory Usage",
        "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"lims-$environment\"} / 1024 / 1024",
            "legendFormat": "MB",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes",
            "min": 0,
            "max": 512,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 300},
                {"color": "red", "value": 450}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "type": "row",
        "title": "Workflow Metrics",
        "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 11,
        "type": "bargauge",
        "title": "Samples by Workflow Stage",
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "lims_active_workflows{environment=\"$environment\"}",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "blue", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "Samples Processed Over Time",
        "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(lims_samples_processed_total{environment=\"$environment\"}[5m])) by (stage)",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["sum", "mean"]}
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "scheme",
              "showPoints": "never"
            }
          }
        }
      },
      {
        "id": 20,
        "type": "row",
        "title": "HTTP Performance",
        "gridPos": {"x": 0, "y": 14, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 21,
        "type": "timeseries",
        "title": "Request Duration by Route",
        "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(lims_http_request_duration_seconds_bucket{environment=\"$environment\"}[5m])) by (route, le))",
            "legendFormat": "{{route}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 22,
        "type": "timeseries",
        "title": "Request Rate by Status Code",
        "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(lims_http_request_duration_seconds_count{environment=\"$environment\"}[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 30
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byRegexp", "options": "5.."},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": "4.."},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": "2.."},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
            }
          ]
        }
      },
      {
        "id": 30,
        "type": "row",
        "title": "Batch Processing",
        "gridPos": {"x": 0, "y": 23, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 31,
        "type": "histogram",
        "title": "Batch Size Distribution",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(lims_batch_size_bucket{environment=\"$environment\"}[5m])) by (le)",
            "legendFormat": "{{le}}",
            "refId": "A",
            "format": "heatmap"
          }
        ],
        "options": {
          "bucketSize": 5
        }
      },
      {
        "id": 32,
        "type": "timeseries",
        "title": "Errors by Type",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(lims_errors_total{environment=\"$environment\"}[5m])) by (type, severity)",
            "legendFormat": "{{type}} ({{severity}})",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byRegexp", "options": ".*critical.*"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            }
          ]
        }
      },
      {
        "id": 40,
        "type": "row",
        "title": "System Resources",
        "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 41,
        "type": "timeseries",
        "title": "CPU Usage",
        "gridPos": {"x": 0, "y": 31, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "rate(process_cpu_user_seconds_total{job=\"lims-$environment\"}[5m]) * 100",
            "legendFormat": "User",
            "refId": "A"
          },
          {
            "expr": "rate(process_cpu_system_seconds_total{job=\"lims-$environment\"}[5m]) * 100",
            "legendFormat": "System",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0
          }
        }
      },
      {
        "id": 42,
        "type": "timeseries",
        "title": "Memory Usage",
        "gridPos": {"x": 8, "y": 31, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"lims-$environment\"} / 1024 / 1024",
            "legendFormat": "Resident",
            "refId": "A"
          },
          {
            "expr": "process_heap_bytes{job=\"lims-$environment\"} / 1024 / 1024",
            "legendFormat": "Heap",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes",
            "min": 0
          }
        }
      },
      {
        "id": 43,
        "type": "timeseries",
        "title": "Event Loop Lag",
        "gridPos": {"x": 16, "y": 31, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "nodejs_eventloop_lag_seconds{job=\"lims-$environment\"}",
            "legendFormat": "Lag",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0
          }
        }
      }
    ]
  },
  "overwrite": true
}
