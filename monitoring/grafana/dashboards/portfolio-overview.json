{
  "dashboard": {
    "id": null,
    "uid": "portfolio-overview",
    "title": "Portfolio Apps Overview",
    "tags": ["portfolio", "overview", "devops"],
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "30s",
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Apps Status",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
        "targets": [
          {
            "expr": "count(up{job=~\"lims.*|portfolio-apps\"} == 1)",
            "legendFormat": "Healthy",
            "refId": "A"
          },
          {
            "expr": "count(up{job=~\"lims.*|portfolio-apps\"} == 0)",
            "legendFormat": "Down",
            "refId": "B"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "orientation": "horizontal"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "type": "table",
        "title": "App Health Status",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "up{job=~\"lims.*|portfolio-apps\"}",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "__name__": true},
              "renameByName": {"job": "Application", "instance": "Endpoint", "Value": "Status"}
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Request Rate by App",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (job)",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right"}
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "LIMS - Production",
        "gridPos": {"x": 0, "y": 12, "w": 6, "h": 4},
        "targets": [
          {"expr": "up{job=\"lims-production\"}", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Pharma App",
        "gridPos": {"x": 6, "y": 12, "w": 6, "h": 4},
        "targets": [
          {"expr": "up{instance=~\".*:30002\"}", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "Finance App",
        "gridPos": {"x": 12, "y": 12, "w": 6, "h": 4},
        "targets": [
          {"expr": "up{instance=~\".*:30003\"}", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 7,
        "type": "stat",
        "title": "Node Exporter",
        "gridPos": {"x": 18, "y": 12, "w": 6, "h": 4},
        "targets": [
          {"expr": "up{job=\"node-exporter\"}", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 8,
        "type": "bargauge",
        "title": "LIMS Workflow Distribution",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "lims_active_workflows",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 9,
        "type": "timeseries",
        "title": "LIMS Workflow Trends",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "lims_active_workflows",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom"}
        }
      },
      {
        "id": 10,
        "type": "gauge",
        "title": "Server1 CPU",
        "gridPos": {"x": 0, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\".*26.128.*\"}[5m])) * 100)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "type": "gauge",
        "title": "Server1 Memory",
        "gridPos": {"x": 6, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\".*26.128.*\"} / node_memory_MemTotal_bytes{instance=~\".*26.128.*\"})) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "type": "gauge",
        "title": "Server2 CPU",
        "gridPos": {"x": 12, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"node-exporter:9100\"}[5m])) * 100)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 13,
        "type": "gauge",
        "title": "Server2 Memory",
        "gridPos": {"x": 18, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes{instance=\"node-exporter:9100\"} / node_memory_MemTotal_bytes{instance=\"node-exporter:9100\"})) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      }
    ]
  },
  "overwrite": true
}
