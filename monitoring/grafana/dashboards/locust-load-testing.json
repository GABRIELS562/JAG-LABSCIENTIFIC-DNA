{
  "dashboard": {
    "id": null,
    "uid": "locust-load-testing",
    "title": "Locust Load Testing",
    "tags": ["locust", "load-testing", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "5s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Test Overview",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Current Users",
        "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "locust_users",
            "legendFormat": "Users",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Requests/sec",
        "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(locust_requests_total[1m]))",
            "legendFormat": "RPS",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Failure Rate",
        "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(locust_requests_fail_total[1m])) / sum(rate(locust_requests_total[1m])) * 100",
            "legendFormat": "Failure %",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Avg Response Time",
        "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "locust_requests_avg_response_time",
            "legendFormat": "Avg",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 500},
                {"color": "red", "value": 2000}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "P95 Response Time",
        "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "locust_requests_95_response_time",
            "legendFormat": "P95",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1000},
                {"color": "red", "value": 3000}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "type": "stat",
        "title": "Total Requests",
        "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(locust_requests_total)",
            "legendFormat": "Total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 10,
        "type": "row",
        "title": "Request Metrics",
        "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "Requests per Second by Endpoint",
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(locust_requests_total[1m])) by (name)",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "Failures per Second by Endpoint",
        "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(locust_requests_fail_total[1m])) by (name)",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 30
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byFrameRefID", "options": "A"},
              "properties": [{"id": "color", "value": {"mode": "palette-classic"}}]
            }
          ]
        }
      },
      {
        "id": 20,
        "type": "row",
        "title": "Response Times",
        "gridPos": {"x": 0, "y": 14, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 21,
        "type": "timeseries",
        "title": "Response Time Percentiles",
        "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "locust_requests_avg_response_time",
            "legendFormat": "Average",
            "refId": "A"
          },
          {
            "expr": "locust_requests_50_response_time",
            "legendFormat": "P50 (Median)",
            "refId": "B"
          },
          {
            "expr": "locust_requests_95_response_time",
            "legendFormat": "P95",
            "refId": "C"
          },
          {
            "expr": "locust_requests_99_response_time",
            "legendFormat": "P99",
            "refId": "D"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 22,
        "type": "timeseries",
        "title": "Response Time by Endpoint",
        "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "locust_requests_avg_response_time_by_name",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean"]}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 30,
        "type": "row",
        "title": "User Load",
        "gridPos": {"x": 0, "y": 23, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 31,
        "type": "timeseries",
        "title": "User Count Over Time",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "locust_users",
            "legendFormat": "Active Users",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 30,
              "gradientMode": "scheme"
            }
          }
        }
      },
      {
        "id": 32,
        "type": "timeseries",
        "title": "Throughput vs Users",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(locust_requests_total[1m]))",
            "legendFormat": "RPS",
            "refId": "A"
          },
          {
            "expr": "locust_users / 10",
            "legendFormat": "Users (scaled /10)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 40,
        "type": "row",
        "title": "Endpoint Details",
        "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 41,
        "type": "table",
        "title": "Endpoint Statistics",
        "gridPos": {"x": 0, "y": 31, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "locust_requests_total",
            "format": "table",
            "instant": true,
            "refId": "A"
          },
          {
            "expr": "locust_requests_fail_total",
            "format": "table",
            "instant": true,
            "refId": "B"
          },
          {
            "expr": "locust_requests_avg_response_time_by_name",
            "format": "table",
            "instant": true,
            "refId": "C"
          }
        ],
        "transformations": [
          {
            "id": "merge"
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
              "renameByName": {
                "name": "Endpoint",
                "Value #A": "Total Requests",
                "Value #B": "Failures",
                "Value #C": "Avg Response (ms)"
              }
            }
          }
        ]
      }
    ]
  },
  "overwrite": true
}
