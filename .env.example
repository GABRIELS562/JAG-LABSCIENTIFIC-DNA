# JAG DNA Scientific LIMS - Environment Configuration Template
# Copy this file to .env and update with your actual values

# Node Environment
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME="JAG DNA Scientific LIMS"
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Backend Server Configuration
PORT=3001
HOST=localhost

# Database Configuration
DATABASE_URL=sqlite:./database/ashley_lims.db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_ENABLE_LOGGING=false

# Authentication & Security
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change-this-to-another-secure-random-secret
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10
SESSION_SECRET=change-this-session-secret-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
CORS_CREDENTIALS=true

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png,.csv,.xlsx

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM="JAG DNA Lab <noreply@jagdna.com>"

# External Services (Optional)
OSIRIS_PATH=/usr/local/bin/osiris
OSIRIS_WORKSPACE=/Users/user/JAG-LABSCIENTIFIC-DNA/backend/osiris_workspace

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# Performance & Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30000

# Background Jobs
ENABLE_WORKFLOW_AUTOMATION=true
WORKFLOW_CYCLE_INTERVAL=10000
SAMPLE_BATCH_SIZE=10

# DevOps Features
ENABLE_DEVOPS_FEATURES=false
ADMIN_PANEL_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Testing Configuration
TEST_DATABASE_URL=sqlite::memory:
TEST_JWT_SECRET=test-secret-key
TEST_PORT=3002

# Production Specific (uncomment in production)
# FORCE_HTTPS=true
# TRUST_PROXY=true
# CLUSTER_WORKERS=4
# COMPRESSION_LEVEL=6