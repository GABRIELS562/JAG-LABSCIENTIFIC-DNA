{
  "dashboard": {
    "id": null,
    "uid": "jagdna-lims-dash",
    "title": "JAGDNA LIMS Production Dashboard",
    "tags": ["kubernetes", "production", "lims"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "graph",
        "title": "Pod CPU Usage",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"production\",pod=~\"jagdna-.*\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "graph",
        "title": "Pod Memory Usage",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace=\"production\",pod=~\"jagdna-.*\"}) by (pod) / 1024 / 1024",
            "legendFormat": "{{pod}}"
          }
        ],
        "yaxes": [
          {
            "format": "decmbytes",
            "show": true
          },
          {
            "format": "short",
            "show": false
          }
        ]
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "stat",
        "title": "Total Pods Running",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "count(up{namespace=\"production\"} == 1)"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center"
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "graph",
        "title": "HTTP Request Rate",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(nginx_ingress_controller_requests{namespace=\"production\"}[5m])) by (status)",
            "legendFormat": "Status {{status}}"
          }
        ]
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "graph",
        "title": "Pod Restart Count",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "kube_pod_container_status_restarts_total{namespace=\"production\"}",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "gauge",
        "title": "Cluster CPU Utilization",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"production\"}[5m])) / sum(kube_pod_container_resource_limits{namespace=\"production\", resource=\"cpu\"}) * 100"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "max": 100,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            },
            "unit": "percent"
          }
        }
      }
    ]
  },
  "overwrite": true
}