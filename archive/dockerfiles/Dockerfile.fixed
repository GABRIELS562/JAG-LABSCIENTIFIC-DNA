# Fixed Docker build for JAG DNA Scientific LIMS
FROM node:20-alpine AS production

# Install system dependencies for better-sqlite3
RUN apk add --no-cache \
    sqlite \
    sqlite-dev \
    python3 \
    python3-dev \
    py3-pip \
    py3-setuptools \
    make \
    g++ \
    curl \
    dumb-init

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S lims -u 1001

# Set working directory
WORKDIR /app

# Copy backend package files and install deps
COPY backend/package*.json ./backend/
RUN cd backend && npm ci --only=production

# Copy backend source
COPY backend ./backend

# Copy the pre-built frontend
COPY dist ./dist

# Copy the modified server that serves frontend
COPY backend/server-with-frontend.js ./backend/server-with-frontend.js

# Create necessary directories
RUN mkdir -p \
    /app/backend/database \
    /app/backend/logs \
    /app/backend/uploads \
    /app/temp && \
    chown -R lims:nodejs /app

# Switch to non-root user
USER lims

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start the server with frontend serving capability
CMD ["node", "backend/server-with-frontend.js"]