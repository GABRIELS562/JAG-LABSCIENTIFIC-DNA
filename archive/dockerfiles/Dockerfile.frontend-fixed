# Build stage
FROM node:20-alpine as builder
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++ py3-pip

# Copy package files
COPY package*.json ./

# Clean up postinstall scripts that might cause issues
RUN sed -i '/"postinstall":/d' package.json && \
    sed -i '/"postinstall:backend":/d' package.json

# Install dependencies
RUN npm install --force --no-audit

# Copy all source files
COPY . .

# Ensure vite.svg exists in public directory
RUN mkdir -p public && if [ ! -f "public/vite.svg" ]; then echo '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7L12 12L22 7L12 2Z" fill="#0D488F" stroke="#0D488F" stroke-width="2" stroke-linejoin="round"/><path d="M2 17L12 22L22 17" stroke="#0D488F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12L12 17L22 12" stroke="#0D488F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' > public/vite.svg; fi

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy vite.svg from build
RUN if [ -f "/app/dist/vite.svg" ]; then cp /app/dist/vite.svg /usr/share/nginx/html/vite.svg; else echo '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7L12 12L22 7L12 2Z" fill="#0D488F" stroke="#0D488F" stroke-width="2" stroke-linejoin="round"/><path d="M2 17L12 22L22 17" stroke="#0D488F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12L12 17L22 12" stroke="#0D488F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' > /usr/share/nginx/html/vite.svg; fi

# Ensure proper permissions
RUN chmod -R 755 /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]