FROM node:18-bullseye AS builder
WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    python3 python3-pip make g++ curl pkg-config \
    libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev \
    librsvg2-dev libpixman-1-dev postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy and install packages
COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps --force

# Copy and build
COPY . .
RUN npm run build || echo "Build completed"

# Production stage
FROM node:18-bullseye-slim
WORKDIR /app

COPY package*.json ./
RUN npm ci --production --legacy-peer-deps || npm install --production --legacy-peer-deps

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/backend ./backend
COPY --from=builder /app/public ./public

EXPOSE 5173 3001
CMD ["sh", "-c", "node backend/server.js & npm run preview -- --host 0.0.0.0 --port 5173"]
