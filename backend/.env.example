# Backend Environment Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:../database/ashley_lims.db
DATABASE_ENABLE_WAL=true
DATABASE_ENABLE_FOREIGN_KEYS=true

# Security - MUST CHANGE IN PRODUCTION
JWT_SECRET=CHANGE-THIS-USE-CRYPTO-RANDOM-BYTES-64-IN-PRODUCTION
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=CHANGE-THIS-ALSO-USE-DIFFERENT-SECRET
SESSION_SECRET=CHANGE-THIS-SESSION-SECRET-TOO

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SLOW_DOWN_WINDOW_MS=900000
SLOW_DOWN_DELAY_AFTER=50
SLOW_DOWN_DELAY_MS=500

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_FILES=14d

# Workflow Configuration
ENABLE_WORKFLOW_AUTOMATION=true
WORKFLOW_CYCLE_INTERVAL=10000
BATCH_SIZE=10

# OSIRIS Integration
OSIRIS_ENABLED=true
OSIRIS_WORKSPACE_PATH=./osiris_workspace
OSIRIS_OUTPUT_PATH=./osiris_workspace/output

# Performance
MAX_MEMORY_MB=512
CLUSTER_WORKERS=1
ENABLE_COMPRESSION=true

# Monitoring
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30000

# Admin Features
ADMIN_PANEL_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-THIS-ADMIN-PASSWORD