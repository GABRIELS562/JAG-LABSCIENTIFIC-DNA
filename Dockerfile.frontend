# Frontend Dockerfile - Multi-stage build for React app with nginx
# Stage 1: Build the React application
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy custom nginx config template
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

# Copy built frontend assets from builder stage
COPY --from=builder /app/dist/ /usr/share/nginx/html/

# Set default backend host (overridden by Helm)
ENV BACKEND_HOST=backend

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# nginx:alpine automatically processes templates in /etc/nginx/templates/
# and outputs to /etc/nginx/conf.d/ using envsubst
CMD ["nginx", "-g", "daemon off;"]
