# Frontend Dockerfile - serves built React app with nginx
FROM nginx:alpine

# Copy custom nginx config template
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

# Copy built frontend assets
COPY dist/ /usr/share/nginx/html/

# Set default backend host (overridden by Helm)
ENV BACKEND_HOST=backend

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# nginx:alpine automatically processes templates in /etc/nginx/templates/
# and outputs to /etc/nginx/conf.d/ using envsubst
CMD ["nginx", "-g", "daemon off;"]
