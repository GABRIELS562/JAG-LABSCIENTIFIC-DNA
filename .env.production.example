# JAG DNA Scientific LIMS - Production Configuration Example
# Copy this file to .env.production for production deployments

# Node Environment
NODE_ENV=production

# Frontend Configuration
# CRITICAL: Use empty string for relative API paths in production/Kubernetes
VITE_API_URL=
VITE_APP_NAME="JAG DNA Scientific LIMS"
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Backend Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration
DB_ADAPTER=postgres

# PostgreSQL Configuration (for Kubernetes deployment)
DB_HOST=postgres-service
DB_PORT=5432
DB_USER=lims_user
DB_PASSWORD=lims2024secure
DB_NAME=limsdb
DATABASE_URL=postgresql://lims_user:lims2024secure@postgres-service:5432/limsdb

# Legacy PostgreSQL Configuration (also supported)
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432
POSTGRES_USER=lims_user
POSTGRES_PASSWORD=lims2024secure
POSTGRES_DB=limsdb

# Database Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_ENABLE_LOGGING=false

# Authentication & Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change-this-refresh-secret-in-production
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10
SESSION_SECRET=change-this-session-secret-in-production

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png,.csv,.xlsx

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# Performance & Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30000

# Background Jobs
ENABLE_WORKFLOW_AUTOMATION=true
WORKFLOW_CYCLE_INTERVAL=10000
SAMPLE_BATCH_SIZE=10

# DevOps Features
ENABLE_DEVOPS_FEATURES=true
ADMIN_PANEL_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Production Specific
FORCE_HTTPS=false
TRUST_PROXY=true
SERVE_STATIC=true
CLUSTER_WORKERS=1
COMPRESSION_LEVEL=6