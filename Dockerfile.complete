FROM node:18-alpine
WORKDIR /app
# Install build dependencies including canvas dependencies for chartjs-node-canvas
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    curl \
    pkgconfig \
    cairo-dev \
    pango-dev \
    jpeg-dev \
    giflib-dev \
    librsvg-dev \
    pixman-dev
COPY package*.json ./
RUN npm install --force
COPY . .
# Create production environment configuration
# Either copy the example file or create .env directly for production
RUN if [ -f .env.production.example ]; then \
      cp .env.production.example .env; \
    else \
      echo 'VITE_API_URL=' > .env; \
    fi
# Build frontend for production with empty VITE_API_URL for relative paths
RUN VITE_API_URL="" npm run build
# Verify build output
RUN ls -la dist/
COPY start-full-app.sh .
RUN chmod +x start-full-app.sh
# Only expose port 3001 since backend serves everything
EXPOSE 3001
CMD ["./start-full-app.sh"]
