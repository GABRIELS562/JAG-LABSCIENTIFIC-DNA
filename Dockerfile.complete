FROM node:18-alpine
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm install --force
COPY . .
# Build frontend for production
RUN npm run build
# Verify build output
RUN ls -la dist/
COPY start-full-app.sh .
RUN chmod +x start-full-app.sh
# Only expose port 3001 since backend serves everything
EXPOSE 3001
CMD ["./start-full-app.sh"]
