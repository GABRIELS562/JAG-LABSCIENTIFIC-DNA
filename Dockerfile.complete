FROM node:18-alpine
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm install --force
COPY . .
# Copy production environment configuration
COPY .env.production .env.production
COPY .env.production .env
# Build frontend for production with empty VITE_API_URL for relative paths
RUN VITE_API_URL="" npm run build
# Verify build output
RUN ls -la dist/
COPY start-full-app.sh .
RUN chmod +x start-full-app.sh
# Only expose port 3001 since backend serves everything
EXPOSE 3001
CMD ["./start-full-app.sh"]
